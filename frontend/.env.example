# ==============================================================================
# Bloop AI Text-to-Speech & Quantum Intelligence — Frontend Environment Template
# ==============================================================================
# Usage:
#   Copy this file to `frontend/.env` for local development.
#   cp frontend/.env.example frontend/.env
#
# SECURITY CONTRACT:
#   Every variable prefixed with `VITE_` is compiled into the public client bundle!
#   DO NOT place any backend secrets, API keys, private tokens, or database URIs here.
#   Only public endpoints and UI configurations are permitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API Base URL
# ------------------------------------------------------------------------------
# Local development endpoint (FastAPI server):
VITE_API_BASE_URL=http://localhost:8000

# Production deployment (Render Web Service):
# On Vercel, configure this in: Project Settings -> Environment Variables
# VITE_API_BASE_URL=https://bloop-backend.onrender.com
