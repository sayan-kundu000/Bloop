# ==============================================================================
# Bloop AI Text-to-Speech & Quantum Intelligence — Backend Environment Template
# ==============================================================================
# Usage:
#   Copy this file to `backend/.env` for local development.
#   cp backend/.env.example backend/.env
#
# SECURITY WARNING:
#   NEVER commit real secrets, private keys, or production database strings to Git!
#   Production credentials must be set directly in the Render dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Profile
# ------------------------------------------------------------------------------
# Active runtime profile: development | test | production
APP_ENV=development

# Debug mode: enables interactive tracebacks and automatic API docs
# MUST be set to false in production! (Startup will fail if true in production)
APP_DEBUG=true

# Application metadata
APP_NAME=Bloop
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
PORT=8000

# ------------------------------------------------------------------------------
# 2. Relational Database Persistence (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Local development default: local SQLite database file
# Production requirement: Render PostgreSQL connection string
# Canonical format: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=sqlite:///./bloop.db

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Token Security
# ------------------------------------------------------------------------------
# Cryptographic secret for signing HMAC-SHA256 tokens (min 32 characters)
# For local dev only; in production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-insecure-secret-key-32characters-minimum-for-testing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Text-to-Speech Provider Configuration (ElevenLabs)
# ------------------------------------------------------------------------------
# Commercial ElevenLabs API key.
# Leave empty for offline local testing (activates built-in SimulationTTSProvider)
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1

# ------------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (wildcard * is strictly prohibited in prod)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://bloop.vercel.app

# ------------------------------------------------------------------------------
# 6. Rate Limiting Safeguards
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE_TTS=10
RATE_LIMIT_PER_MINUTE_QUANTUM=15
RATE_LIMIT_PER_MINUTE_AUTH=5

# ------------------------------------------------------------------------------
# 7. Local Audio Storage & Constraints
# ------------------------------------------------------------------------------
AUDIO_STORAGE_PATH=backend/app/storage/audio
MIN_TEXT_LENGTH=1
MAX_TEXT_LENGTH=2500

# ------------------------------------------------------------------------------
# 8. Quantum Intelligence Simulation Guardrails
# ------------------------------------------------------------------------------
# Quantum subsystem toggle: can be disabled without affecting core TTS
QUANTUM_ENABLED=true
QUANTUM_SIMULATOR_SHOTS=1024
QUANTUM_MAX_QUBITS=8
QUANTUM_MAX_EXECUTION_TIME=30

# ------------------------------------------------------------------------------
# 9. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Minimum log severity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
