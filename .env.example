# ==============================================================================
# Bloop AI Text-to-Speech & Quantum Intelligence — Monorepo Environment Template
# ==============================================================================
# Architecture Reference: Twelve-Factor Externalized Configuration
# Authority: Prompt 06 — Environment Configuration & Secrets Management
#
# QUICK START:
#   Backend:  cp backend/.env.example backend/.env
#   Frontend: cp frontend/.env.example frontend/.env
#
# SECURITY CONTRACT:
#   1. NEVER commit unmasked .env files to version control.
#   2. The Frontend bundle MUST ONLY receive public values (prefixed with VITE_).
#   3. Backend secrets (JWT_SECRET_KEY, ELEVENLABS_API_KEY, DATABASE_URL) exist
#      strictly on the Render Web Service and local developer machines.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Runtime Profile
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_NAME=Bloop
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Persistence (Render PostgreSQL / Local SQLite)
# ------------------------------------------------------------------------------
# Local development fallback:
DATABASE_URL=sqlite:///./bloop.db
# Production Render PostgreSQL format:
# DATABASE_URL=postgresql+psycopg2://bloop_user:SECRET_PASSWORD@dpg-xxx.render.com:5432/bloop_db

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Cryptographic key for HMAC-SHA256 signing (min 32 characters)
JWT_SECRET_KEY=dev-insecure-secret-key-32characters-minimum-for-testing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Text-to-Speech Provider (ElevenLabs)
# ------------------------------------------------------------------------------
# Optional in local dev (falls back to SimulationTTSProvider at zero cost)
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1

# ------------------------------------------------------------------------------
# 5. CORS Origins
# ------------------------------------------------------------------------------
# Wildcard (*) is strictly rejected at application startup in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://bloop.vercel.app

# ------------------------------------------------------------------------------
# 6. Rate Limiting Limits
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE_TTS=10
RATE_LIMIT_PER_MINUTE_QUANTUM=15
RATE_LIMIT_PER_MINUTE_AUTH=5

# ------------------------------------------------------------------------------
# 7. Local Audio Storage
# ------------------------------------------------------------------------------
AUDIO_STORAGE_PATH=backend/app/storage/audio
MIN_TEXT_LENGTH=1
MAX_TEXT_LENGTH=2500

# ------------------------------------------------------------------------------
# 8. Quantum Intelligence Engine Guardrails
# ------------------------------------------------------------------------------
QUANTUM_ENABLED=true
QUANTUM_SIMULATOR_SHOTS=1024
QUANTUM_MAX_QUBITS=8
QUANTUM_MAX_EXECUTION_TIME=30

# ------------------------------------------------------------------------------
# 9. Logging Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 10. Frontend Client Public Setting (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
